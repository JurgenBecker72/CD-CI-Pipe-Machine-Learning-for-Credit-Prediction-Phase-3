# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------- Virtual environments ----------
.venv/
venv/
env/
ENV/
# Locked-folder leftovers from venv rebuilds (Windows file-handle issues)
*-old-locked/

# ---------- uv ----------
# uv.lock IS committed (reproducibility) — do not ignore it.
# These are uv's caches/scratch files and should not be tracked.
.uv-cache/
uv-receipt.json

# ---------- Local services data ----------
warehouse/
mlflow-data
mlflow-data/
.docker-compose-state/

# ---------- IDE / OS ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
# Microsoft Office lock files (created when a doc is open in Word/Excel/PowerPoint)
~$*

# ---------- Secrets ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Data — never commit raw or processed ----------
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Same rules apply inside archived builds
archive/**/data/raw/*
archive/**/data/processed/*

# ---------- Model artefacts ----------
models/*
!models/.gitkeep
archive/**/models/*

# ---------- Generated reports ----------
reports/*.csv
reports/*.json
reports/*.html
reports/*.png
reports/*.pdf
!reports/.gitkeep
archive/**/reports/*.csv
archive/**/reports/*.json
archive/**/reports/*.html
archive/**/reports/*.png
archive/**/reports/*.pdf

# ---------- Scratch working files ----------
review_report.docx
review_report.js
WJARR-2025-2266.pdf
**/WJARR-2025-2266.pdf
Claude fix OpenAI code/

# ---------- Logs ----------
*.log
logs/

# ---------- Editor / hot-reload temp files ----------
# uvicorn --reload sometimes leaves <file>.tmp.<pid>.<hash> droppings if the
# worker is killed uncleanly. Generic .tmp.* catches those plus any other
# tool that writes atomic-rename staging files.
*.tmp.*

# Cowork / Claude session artifacts
Claude/
